# Copy to .env and adjust. Placeholders only - never commit real secrets.
NODE_ENV=development
PORT=4000
DATABASE_URL=file:./data/taskflow.db
# REQUIRED when NODE_ENV=production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false
SEED_ON_START=true
# Live demo only: reset demo data every N minutes (0 = off)
DEMO_RESET_INTERVAL_MINUTES=0
# Local docker compose only: generate a random JWT secret per start instead of failing in production
# ALLOW_EPHEMERAL_JWT_SECRET=false
# Single-image deploy: path to the built web app, served by the API
# SERVE_WEB_DIR=./web/dist
# docker compose: published web port
WEB_PORT=8080
# Vite dev proxy target
API_PROXY_TARGET=http://localhost:4000
